<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane minHeight="440.0" minWidth="740.0" prefHeight="440.0" prefWidth="740.0" xmlns:fx="http://javafx.com/fxml" fx:controller="br.edu.usp.javalibrary.javalibrary.view.book.BookController">
   <children>
      <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <VBox VBox.vgrow="NEVER">
               <children>
                  <GridPane minHeight="50.0" prefHeight="50.0" VBox.vgrow="NEVER">
                     <columnConstraints>
                        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="200.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="110.0" minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="110.0" minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="110.0" minWidth="110.0" prefWidth="110.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="50.0" prefHeight="50.0" vgrow="NEVER" />
                     </rowConstraints>
                     <children>
                        <Label fx:id="bookTitle" alignment="CENTER_LEFT" maxHeight="50.0" maxWidth="1.7976931348623157E308" minHeight="50.0" minWidth="200.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Livros" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                        </Label>
                        <Button fx:id="addBook" maxHeight="50.0" maxWidth="105.0" minHeight="50.0" minWidth="105.0" mnemonicParsing="false" onAction="#handleButtonAddBook" prefHeight="50.0" prefWidth="105.0" text="Adicionar Livro" GridPane.columnIndex="1" />
                        <Button fx:id="updateBook" maxHeight="50.0" maxWidth="105.0" minHeight="50.0" minWidth="105.0" mnemonicParsing="false" onAction="#handleButtonUpdateBook" prefHeight="50.0" prefWidth="105.0" text="Editar Livro" GridPane.columnIndex="2" />
                        <Button fx:id="removeBook" maxHeight="50.0" maxWidth="105.0" minHeight="50.0" minWidth="105.0" mnemonicParsing="false" onAction="#handleButtonRemoveBook" prefHeight="50.0" prefWidth="105.0" text="Remover Livro" GridPane.columnIndex="3" />
                     </children>
                  </GridPane>
               </children>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="NEVER">
               <children>
                  <TextField fx:id="search" prefHeight="30.0" promptText="Pesquisar por título, isbn, categoria ou autor..." HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleButtonSearch" prefHeight="30.0" prefWidth="100.0" text="Pesquisar" />
                  <Button mnemonicParsing="false" onAction="#handleButtonClear" prefHeight="30.0" prefWidth="100.0" text="Limpar" />
               </children>
            </HBox>

            <TableView fx:id="booksTable" minHeight="320.0" minWidth="640.0" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="isbn" minWidth="100.0" prefWidth="100.0" text="ISBN" />
                  <TableColumn fx:id="title" minWidth="100.0" prefWidth="100.0" text="Título" />
                  <TableColumn fx:id="description" minWidth="100.0" prefWidth="100.0" text="Descrição" />
                  <TableColumn fx:id="publisher" minWidth="100.0" prefWidth="100.0" text="Editora" />
                  <TableColumn fx:id="copies" minWidth="50.0" prefWidth="60.0" text="Cópias" />
                  <TableColumn fx:id="author" minWidth="100.0" prefWidth="100.0" text="Autor" />
                  <TableColumn fx:id="category" minWidth="100.0" prefWidth="100.0" text="Categoria" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
