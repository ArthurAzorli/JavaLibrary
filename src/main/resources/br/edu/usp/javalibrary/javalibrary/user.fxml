<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane minHeight="440.0" minWidth="740.0" prefHeight="440.0" prefWidth="740.0" xmlns:fx="http://javafx.com/fxml"  fx:controller="br.edu.usp.javalibrary.javalibrary.view.user.UserController">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <VBox VBox.vgrow="NEVER">
                    <children>
                        <GridPane minHeight="50.0" prefHeight="50.0" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="200.0" />
                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="50.0" prefHeight="50.0" vgrow="NEVER" />
                            </rowConstraints>
                            <children>
                                <Label fx:id="userTitle" alignment="CENTER_LEFT" maxHeight="50.0" maxWidth="1.7976931348623157E308" minHeight="50.0" minWidth="200.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Usuários" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                                    <padding>
                                        <Insets left="10.0" />
                                    </padding>
                                </Label>
                                <Button fx:id="addUser" maxHeight="50.0" maxWidth="110.0" minHeight="50.0" minWidth="110.0" mnemonicParsing="false" onAction="#handleButtonAddUser" prefHeight="50.0" prefWidth="110.0" text="Adicionar Usuário" GridPane.columnIndex="1" />
                                <Button fx:id="updateUser" maxHeight="50.0" maxWidth="110.0" minHeight="50.0" minWidth="110.0" mnemonicParsing="false" onAction="#handleButtonUpdateUser" prefHeight="50.0" prefWidth="110.0" text="Editar Usuário" GridPane.columnIndex="2" />
                                <Button fx:id="removeUser" maxHeight="50.0" maxWidth="110.0" minHeight="50.0" minWidth="110.0" mnemonicParsing="false" onAction="#handleButtonRemoveUser" prefHeight="50.0" prefWidth="110.0" text="Remover Usuário" GridPane.columnIndex="3" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="NEVER">
                    <children>
                        <TextField fx:id="search" prefHeight="30.0" promptText="Pesquisar por nome ou e-mail..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleButtonSearch" prefHeight="30.0" prefWidth="100.0" text="Pesquisar" />
                        <Button mnemonicParsing="false" onAction="#handleButtonClear" prefHeight="30.0" prefWidth="100.0" text="Limpar" />
                    </children>
                </HBox>

                <TableView fx:id="usersTable" minHeight="300.0" minWidth="640.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="id" minWidth="150.0" prefWidth="150.0" text="ID (UUID)" />
                        <TableColumn fx:id="name" minWidth="150.0" prefWidth="150.0" text="Nome" />
                        <TableColumn fx:id="email" minWidth="150.0" prefWidth="150.0" text="E-mail" />
                        <TableColumn fx:id="address" minWidth="180.0" prefWidth="180.0" text="Endereço" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
