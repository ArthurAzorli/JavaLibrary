<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane minHeight="440.0" minWidth="740.0" prefHeight="440.0" prefWidth="740.0" xmlns:fx="http://javafx.com/fxml" fx:controller="br.edu.usp.javalibrary.javalibrary.view.loan.LoanController">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <VBox VBox.vgrow="NEVER">
                    <children>
                        <GridPane minHeight="50.0" prefHeight="50.0" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="200.0" />
                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="150.0" minWidth="130.0" prefWidth="140.0" />
                                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" maxWidth="130.0" minWidth="110.0" prefWidth="120.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="50.0" prefHeight="50.0" vgrow="NEVER" />
                            </rowConstraints>
                            <children>
                                <Label alignment="CENTER_LEFT" maxHeight="50.0" maxWidth="1.7976931348623157E308" minHeight="50.0" minWidth="200.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Empréstimos" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                                    <padding> <Insets left="10.0" /> </padding>
                                </Label>
                                <Button maxHeight="50.0" maxWidth="130.0" minHeight="50.0" minWidth="130.0" mnemonicParsing="false" onAction="#handleButtonAddLoan" prefHeight="50.0" prefWidth="130.0" text="Novo Empréstimo" GridPane.columnIndex="1" />
                                <Button maxHeight="50.0" maxWidth="110.0" minHeight="50.0" minWidth="110.0" mnemonicParsing="false" onAction="#handleButtonUpdateLoan" prefHeight="50.0" prefWidth="110.0" text="Editar / Devolver" GridPane.columnIndex="2" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="NEVER">
                    <children>
                        <TextField fx:id="search" prefHeight="30.0" promptText="Pesquisar por ISBN do livro ou ID do usuário..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleButtonSearch" prefHeight="30.0" prefWidth="100.0" text="Pesquisar" />
                        <Button mnemonicParsing="false" onAction="#handleButtonClear" prefHeight="30.0" prefWidth="100.0" text="Limpar" />
                    </children>
                </HBox>

                <TableView fx:id="loansTable" minHeight="320.0" minWidth="640.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" minWidth="80.0" prefWidth="100.0" text="ID Empréstimo" />
                        <TableColumn fx:id="colIsbn" minWidth="100.0" prefWidth="120.0" text="ISBN Livro" />
                        <TableColumn fx:id="colUserId" minWidth="100.0" prefWidth="120.0" text="ID Usuário" />
                        <TableColumn fx:id="colStart" minWidth="100.0" prefWidth="120.0" text="Data Empréstimo" />
                        <TableColumn fx:id="colEndPrevision" minWidth="100.0" prefWidth="120.0" text="Previsão Devolução" />
                        <TableColumn fx:id="colEnd" minWidth="100.0" prefWidth="120.0" text="Data Entrega" />
                        <TableColumn fx:id="colStatus" minWidth="80.0" prefWidth="90.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>